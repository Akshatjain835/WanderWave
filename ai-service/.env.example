LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=WanderWave

# Qdrant Cloud Vector Database Config (RAG)
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_HOST=https://your-cluster.qdrant.tech

